{
  "name": "wagner/monolith-php",
  "description": "Monolito modular PHP",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "illuminate/database": "^10.0",
    "illuminate/events": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Core\\": "src/Core/",
      "App\\Modules\\": "src/Modules/",
      "App\\Shared\\": "src/Shared/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  }
}
